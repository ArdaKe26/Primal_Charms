{
  "schemaVersion": 1,
  "id": "primal-charms",
  "version": "${version}",
  "name": "Primal Charms",
  "description": "This mod is primal charms mod which you can equip the charms as necklaces and gain animal powers",
  "authors": ["ardake26"],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/primal-charms/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.ardake26.primalcharms.PrimalCharms"],
    "client": ["io.github.ardake26.primalcharms.client.PrimalCharmsClient"]
  },
  "mixins": [
    "primal-charms.mixins.json",
    {
      "config": "primal-charms.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "trinkets": "*"
  }
}
